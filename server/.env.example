# Cognipaper Backend Environment Configuration
# Copy this file to .env and configure your values

# HTTP Server Port
PORT=5000

# Allowed CORS Origin for Local Development (Frontend Vite Server)
CORS_ORIGIN=http://localhost:5173

# Google Gemini API Key (Required for live AI synthesis & model verification)
# Get your API key from https://aistudio.google.com/
# NEVER commit your actual API key to version control
GEMINI_API_KEY=
